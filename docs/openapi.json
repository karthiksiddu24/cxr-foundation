          "logit_min",
          "logit_max"
        ],
        "title": "Heatmap",
        "type": "object"
      },
      "HeatmapGeometry": {
        "additionalProperties": false,
        "description": "Maps the square model-input space onto the original image.\n\noriginal_x = (model_x - pad_x) / scale, likewise for y. The heatmap grid spans the full\nsquare [0, input_size) in both axes.",
        "properties": {
          "grid_h": {
            "title": "Grid H",
            "type": "integer"
          },
          "grid_w": {
            "title": "Grid W",
            "type": "integer"
          },
          "input_size": {
            "title": "Input Size",
            "type": "integer"
          },
          "pad_x": {
            "title": "Pad X",
            "type": "integer"
          },
          "pad_y": {
            "title": "Pad Y",
            "type": "integer"
          },
          "scale": {
            "title": "Scale",
            "type": "number"
          }
        },
        "required": [
          "input_size",
          "grid_h",
          "grid_w",
          "scale",
          "pad_x",
          "pad_y"
        ],
        "title": "HeatmapGeometry",
        "type": "object"
      },
