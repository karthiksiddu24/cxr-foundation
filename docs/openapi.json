      "Quality": {
        "additionalProperties": false,
        "properties": {
          "ood_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Squared Mahalanobis distance of the image embedding to training data",
            "title": "Ood Score"
          },
          "ood_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
