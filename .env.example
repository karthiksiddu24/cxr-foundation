# ---------------------------------------------------------------------------------------------
# CXR-Foundation configuration. Copy to .env and adjust. Every variable has a working default.
# ---------------------------------------------------------------------------------------------

# ===== Data & training (ml) ==================================================================
# Root for datasets, processed arrays, runs, checkpoints and evaluation artifacts (outside git).
CXR_DATA_ROOT=/data/cxr
# Raw dataset locations (defaults: $CXR_DATA_ROOT/raw/<name>). CheXpert and VinDr require
# license agreements; place their files here yourself (see docs/datasets.md).
CXR_NIH_RAW=/data/cxr/raw/nih
CXR_CHEXPERT_RAW=/data/cxr/raw/chexpert
CXR_VINDR_RAW=/data/cxr/raw/vindr
# Experiment tracking: training configs choose `tracking: mlflow|wandb|none`.
# MLflow defaults to a local file store under $CXR_DATA_ROOT/mlflow/runs.
MLFLOW_TRACKING_URI=
# W&B runs offline unless you set WANDB_MODE=online and are logged in (`wandb login`).
WANDB_MODE=offline

# ===== Inference server (server) =============================================================
# Model bundle directory (manifest.json + model.onnx + ood.npz).
CXR_BUNDLE_DIR=/data/cxr/artifacts/bundles/current
# ONNX Runtime providers: auto (CUDA if available, else CPU) | cpu | cuda
CXR_ORT_PROVIDERS=auto
CXR_MAX_UPLOAD_MB=25
CXR_MIN_IMAGE_SIDE=256
CXR_MAX_IMAGE_SIDE=8192
# Longest side of the PNG returned for display.
CXR_DISPLAY_MAX_SIDE=1024
# JSON list of allowed browser origins (only needed if the browser calls the API directly).
CXR_CORS_ORIGINS=["http://localhost:3000"]
# slowapi syntax, per client IP.
CXR_RATE_LIMIT=30/minute
CXR_LOG_LEVEL=INFO
# JSON logs (true) or human-readable console logs (false).
CXR_LOG_JSON=true
# Run a warmup inference before reporting ready.
CXR_WARMUP=true

# ===== Web app (web) =========================================================================
# Where the Next.js server reaches the API (used for the /api proxy and the model card page).
# In Docker this is baked in at build time (build arg); for `npm run dev` set it here.
API_INTERNAL_URL=http://localhost:8000
# Browser-side API base path; leave as /api to use the same-origin proxy.
NEXT_PUBLIC_API_BASE=/api

# ===== Docker Compose ========================================================================
# Host directory holding the model bundle mounted into the API container.
CXR_BUNDLE_HOST_DIR=./models/current
